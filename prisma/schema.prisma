// ============================================================
// SVH Nutrition Club — Prisma Schema
// ============================================================
// Database: PostgreSQL via Supabase
// ORM: Prisma v7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================== ENUMS ========================

enum Role {
  GUEST
  CUSTOMER
  ASSOCIATE
  ADMIN
}

enum ConsultationType {
  VIDEO
  VOICE
  CHAT
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ProductCategory {
  SHAKES
  TEAS
  SUPPLEMENTS
  SKIN
  OTHER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// ======================== USER ========================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  phone          String?
  role           Role      @default(CUSTOMER)
  isActive       Boolean   @default(true)
  language       String    @default("en")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Hierarchy fields for Admin -> Associate -> Customer
  adminId        String?
  associateId    String?

  // Relations
  admin           User?          @relation("AdminToAssociate", fields: [adminId], references: [id])
  associates      User[]         @relation("AdminToAssociate")
  associate       User?          @relation("AssociateToCustomer", fields: [associateId], references: [id])
  customers       User[]         @relation("AssociateToCustomer")

  accounts        Account[]
  consultations   Consultation[]
  bodyMetrics     BodyMetric[]
  mealPlans       MealPlan[]
  notifications   Notification[]
  transformations Transformation[]
  auditLogs       AuditLog[]
  contactInquiries ContactInquiry[]
  orders          Order[]
  
  // Phase 1 Relations
  habits                 Habit[]
  challengeParticipations ChallengeParticipation[]
  reminders              Reminder[]
  journalEntries         JournalEntry[]
  membership             Membership?
  aiReports              AIReport[]
  ocrReports             OCRReport[]
  nutritionScans         NutritionScan[]
  aiUsages               AIUsage[]
  sentMessages           ConsultationMessage[]
  wellnessProfile        WellnessProfile?
  goals                  Goal[]
  nutritionLogs          NutritionLog[]
  wellnessPlans          WellnessPlan[]

  @@map("users")
}

// ======================== AUTH (NextAuth) ========================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ======================== PRODUCTS ========================

model Product {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String          @db.Text
  price         Float
  originalPrice Float?
  category      ProductCategory
  image         String?
  badge         String?
  benefits      String[]
  tags          String[]
  rating        Float           @default(0)
  reviewCount   Int             @default(0)
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  orderItems    OrderItem[]

  @@map("products")
}

// ======================== BLOG ========================

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String     @db.Text
  content     String     @db.Text
  category    String
  author      String
  readTime    String
  image       String?
  status      BlogStatus @default(DRAFT)
  featured    Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_posts")
}

// ======================== CONSULTATIONS ========================

model Consultation {
  id        String             @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String
  type      ConsultationType
  status    ConsultationStatus @default(PENDING)
  date      DateTime
  time      String
  goals     String[]
  message   String?            @db.Text
  notes     String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ConsultationMessage[]

  @@map("consultations")
}

// ======================== TRANSFORMATIONS ========================

model Transformation {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  age          Int
  location     String
  beforeWeight Float
  afterWeight  Float
  duration     String
  story        String   @db.Text
  achievements String[]
  beforeImage  String?
  afterImage   String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("transformations")
}

// ======================== BODY METRICS ========================

model BodyMetric {
  id               String   @id @default(cuid())
  userId           String
  weight           Float?
  height           Float?
  bmi              Float?
  bmr              Float?
  bodyFat          Float?
  muscleMass       Float?
  visceralFat      Float?
  subcutaneousFat  Float?
  waterPercent     Float?
  boneMass         Float?
  metabolicAge     Int?
  chronologicalAge Int?
  healthScore      Float?
  notes            String?  @db.Text
  source           String?  // e.g., "manual", "ocr", "smart-scale"
  measuredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("body_metrics")
}

// ======================== MEAL PLANS ========================

model MealPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  meals       Json     // Structured meal data: { breakfast, lunch, dinner, snacks }
  calories    Int?
  protein     Float?
  carbs       Float?
  fats        Float?
  hydration   Float?   // liters
  aiProvider  String?  // "groq" | "gemini"
  isActive    Boolean  @default(true)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meal_plans")
}

// ======================== NOTIFICATIONS ========================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   // "info" | "success" | "warning" | "reminder"
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ======================== AUDIT LOG ========================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ======================== CONTACT ========================

model ContactInquiry {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_inquiries")
}

// ======================== ORDERS ========================

model Order {
  id              String      @id @default(cuid())
  userId          String?
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  paymentId       String?
  shippingAddress String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

// ======================== NEW MODELS (PHASE 1) ========================

model Habit {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  frequency   String   @default("DAILY")
  streak      Int      @default(0)
  longestStreak Int    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @default(now())
  completed Boolean  @default(true)
  notes     String?  @db.Text

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  duration    Int      // in days
  goal        String
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ChallengeParticipation[]

  @@map("challenges")
}

model ChallengeParticipation {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("challenge_participations")
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  type        String   // e.g., "WATER", "MEAL", "HABIT", "CONSULTATION"
  time        String   // "HH:MM"
  days        Int[]    // 0 = Sunday, 1 = Monday, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  content   String   @db.Text
  mood      String?
  aiSummary String?  @db.Text
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @unique
  qrCode      String   @unique @default(cuid()) // Unique safe identifier
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED
  plan        String   @default("BASIC")
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

model AIReport {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  type      String   // e.g., "WELLNESS", "MONTHLY_REVIEW"
  metadata  Json?    // Store related data snapshots
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_reports")
}

model OCRReport {
  id          String   @id @default(cuid())
  userId      String
  fileUrl     String
  fileName    String
  status      String   @default("PENDING") // PENDING, EXTRACTED, VERIFIED, FAILED
  extractedData Json?
  confidence  Float?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ocr_reports")
}

model NutritionScan {
  id             String   @id @default(cuid())
  userId         String
  imageUrl       String
  foodIdentified String?
  calories       Int?
  protein        Float?
  carbs          Float?
  fats           Float?
  confidence     Float?
  explanation    String?  @db.Text
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_scans")
}

model AIUsage {
  id        String   @id @default(cuid())
  userId    String?
  provider  String   // "GROQ", "GEMINI"
  feature   String   // "MEAL_PLAN", "OCR", "SCAN", "CHAT"
  tokens    Int      @default(0)
  latencyMs Int      @default(0)
  success   Boolean  @default(true)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("ai_usage")
}

model ConsultationMessage {
  id             String   @id @default(cuid())
  consultationId String
  senderId       String
  content        String   @db.Text
  isAi           Boolean  @default(false)
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("consultation_messages")
}

// ======================== NEW MODELS (PHASE 25) ========================

model WellnessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  age               Int?
  gender            String?
  dietaryPreference String?
  foodAllergies     String?
  foodDislikes      String?
  wellnessGoal      String?
  activityLevel     String?
  preferredLanguage String   @default("en-US")
  climate           String?
  sleepTarget       Float?
  waterTarget       Float?
  dailyStepsTarget  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wellness_profiles")
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  title         String
  type          String   // e.g., "WEIGHT_LOSS", "MUSCLE_GAIN"
  startingValue Float?
  currentValue  Float?
  targetValue   Float?
  unit          String?
  targetDate    DateTime?
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, ABANDONED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model NutritionLog {
  id            String   @id @default(cuid())
  userId        String
  mealType      String   // e.g., "BREAKFAST", "LUNCH"
  foodName      String
  calories      Int?
  protein       Float?
  carbs         Float?
  fats          Float?
  fiber         Float?
  imageUrl      String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_logs")
}

model WellnessPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  duration    Int      // e.g., 7 or 30 days
  planData    Json     // AI generated plan structure
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wellness_plans")
}
